# ===================================================================
# SMART EVENT PLATFORM — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In PRODUCTION, JWT_SECRET and EMAIL_CREDENTIAL_ENCRYPTION_KEY are strictly required.

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local MongoDB)
# Production MongoDB Atlas URI example:
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartevent?retryWrites=true&w=majority"
# Development Local MongoDB example:
# DATABASE_URL="mongodb://localhost:27017/smartevent"

# Cryptography & Security Secrets (REQUIRED in production)
# Generate cryptographically random strings (e.g. openssl rand -base64 32)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here
EMAIL_CREDENTIAL_ENCRYPTION_KEY=your_production_32_byte_aes_encryption_key_here

# System Email Provider (mock / smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM="Smart Event Platform <noreply@smartevent.io>"
SMTP_FROM_NAME="Smart Event Platform"
SUPPORT_EMAIL="support@smartevent.io"

# Platform System SMTP Settings (Optional fallback for platform password resets)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# AI Certificate Studio Provider (mock / gemini / openai)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
